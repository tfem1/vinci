{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VINCI",
  "mainBinaryName": "vinci",
  "version": "0.1.1",
  "identifier": "app.vinci.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VINCI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#090909"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "publisher": "VINCI",
    "copyright": "© VINCI contributors — MIT License",
    "license": "MIT",
    "category": "Video",
    "shortDescription": "Capture Every Moment — lightweight instant replay for games",
    "longDescription": "VINCI keeps the last minutes of your gameplay in a GPU-encoded replay buffer and saves clips instantly with a hotkey, without re-encoding. Lightweight, private, no account, no cloud.",
    "homepage": "https://github.com/tfem1/vinci",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "gstreamer1.0-plugins-good", "gstreamer1.0-libav", "gstreamer1.0-pipewire", "xdg-desktop-portal"],
        "section": "video"
      },
      "rpm": {
        "depends": ["/usr/bin/ffmpeg", "gstreamer1-plugins-good", "pipewire-gstreamer"],
        "release": "1"
      },
      "appimage": { "bundleMediaFramework": true }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "VINCI"
      },
      "wix": { "language": "en-US" }
    }
  }
}
